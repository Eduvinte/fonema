PORT=3000

JWT_ACCESS_SECRET=cambia-esto-acceso
JWT_REFRESH_SECRET=cambia-esto-refresh
CORS_ORIGIN=http://localhost:5173

# Flow.cl (sandbox por defecto)
FLOW_ENV=sandbox
FLOW_API_KEY=tu-api-key-sandbox
FLOW_SECRET_KEY=tu-secret-key-sandbox
