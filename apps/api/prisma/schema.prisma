generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PREMIUM
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String?
  plan               Plan      @default(FREE)
  role               UserRole  @default(USER)
  flowCustomerId     String?   @unique
  flowSubscriptionId String?
  aiWordsUsed        Int       @default(0)
  aiPeriodStart      DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sections      Section[]
  payments      Payment[]
  refreshTokens RefreshToken[]
  chatMessages  ChatMessage[]
  conversations ChatConversation[]
  events        AnalyticsEvent[]

  @@map("users")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}

model ChatConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Nueva conversación")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId   String
  conversation     ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String
  content          String
  action           Json?
  status           String   @default("idle")
  executedSectionId String?
  createdAt        DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model Section {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  words     Word[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sections")
}

model Word {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text        String
  translation String?
  example     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sectionId])
  @@map("words")
}

model AudioCache {
  id        String   @id @default(cuid())
  textHash  String   @unique
  voice     String
  bytes     Bytes
  createdAt DateTime @default(now())

  @@map("audio_cache")
}

model Payment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flowOrder     Int       @unique
  commerceOrder String    @unique
  amount        Float
  status        Int
  subject       String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@map("payments")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}
